{
  "name": "stelstone-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Astro site + the Stelstone admin, deployed as one Cloudflare Worker.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/.bin/astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@stelstone/admin-ui": "^0.33.0",
    "@stelstone/astro-blocks": "^0.13.1",
    "@stelstone/blocks": "^0.15.0",
    "@stelstone/server": "^0.43.0",
    "@stelstone/worker": "^0.10.0",
    "astro": "^7.0.0",
    "stelstone": "^6.2.3"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
