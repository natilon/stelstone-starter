// At the repo root on purpose: Workers Builds (and the deploy button) run a
// bare `npx wrangler deploy`. With no config here, Wrangler "auto-configures"
// the project by running `astro add cloudflare`, which swaps in an SSR
// adapter this static site doesn't use — and the build breaks.
{
  // What the deploy button offers as the Worker and repository name. A
  // placeholder on purpose: rename it to your site in the deploy form.
  "name": "my-stelstone-site",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // One assets directory carries both the site (dist/) and the admin SPA
  // (dist/admin/, copied there by scripts/postbuild.mjs). A request matching
  // a real file is served by the platform WITHOUT running the worker; every
  // miss falls through to the worker — which is where redirects, the API,
  // the admin SPA fallback and the 404 page live. Deliberately NO
  // `not_found_handling` here: it would answer misses at the asset layer and
  // the redirect middleware would never see them.
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },

  // OPTIONAL — page templates (reusable block sets in the admin). The CMS
  // runs fine without this: the templates list is just empty. To enable:
  //   npx wrangler kv namespace create TEMPLATES_KV
  // then uncomment with the id it prints. Deliberately not present by
  // default: the deploy button does not provision KV, and a placeholder id
  // fails the whole deploy.
  // "kv_namespaces": [
  //   { "binding": "TEMPLATES_KV", "id": "<your-kv-namespace-id>" }
  // ],

  // Scheduled publish: pages whose publish date has passed go live.
  "triggers": { "crons": ["* * * * *"] },

  "observability": { "enabled": true }

  // Secrets — npx wrangler secret put <NAME>
  //   GITHUB_TOKEN     fine-grained PAT with read/write Contents on THIS repo
  //   ADMIN_PASS       admin panel password
  //   RESEND_API_KEY   (optional) contact-form delivery
}
